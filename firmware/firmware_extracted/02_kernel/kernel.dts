				arobot,pull = <0x01>;
			};

			spi1_0 {
				pins = "PA6\0PA7\0PA8\0PA9";
				function = "spi1";
				arobot,drive = <0x03>;
				arobot,pull = <0x01>;
			};

			spi1_0_s {
