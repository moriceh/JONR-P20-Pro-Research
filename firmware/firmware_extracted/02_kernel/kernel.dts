			major = <0x113>;
			status = "disabled";
		};

		vacc@4007c000 {
			compatible = "arobot,r8-vacc";
			reg = <0x4007c000 0x200>;
			interrupts = <0x00 0x34 0x04>;
			clocks = <0x02 0x0d>;
			clock-names = "ap_vacc";
			vacc-sram = <0x88000>;
			vacc-sram-size = <0x7800>;
			resets = <0x0a 0x54>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			major = <0x115>;
			status = "disabled";
		};

		rp@40000 {
			compatible = "arobot,r8-rp";
			reg-names = "rp_mem";
			reg = <0x40000 0x48000>;
			clocks = <0x02 0x36 0x02 0x07>;
			clock-names = "ap_chipid\0pll_ltl";
			resets = <0x0a 0x06>;
			major = <0x117>;
			status = "okay";
		};

		gauss@400aa000 {
			compatible = "arobot,r8-gauss";
			reg = <0x400aa000 0x200>;
			interrupts = <0x00 0x0e 0x04>;
			clocks = <0x02 0x12>;
			clock-names = "ap_sift";
			resets = <0x0a 0x50>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			major = <0xf4>;
			max-mem-order = <0x0a>;
			status = "disabled";
		};

		aes@400a2000 {
			compatible = "arobot,r8-aes";
			reg = <0x400a2000 0x50>;
			interrupts = <0x00 0x2a 0x04>;
			clocks = <0x02 0x24>;
			clock-names = "ap_aes";
			resets = <0x0a 0x40>;
			dmas = <0x25 0x08 0x04 0x22 0x0a 0x04>;
			dma-names = "in\0out";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			max-mem-order = <0x0a>;
			status = "disabled";
		};

		adc@40080000 {
			compatible = "arobot,r8-adc";
			reg = <0x40080000 0x2000 0x40008000 0x100 0x4003c000 0x100>;
			reg-names = "ccu\0adc\0rtc";
			force-init = <0x00>;
			sampling-frequency = <0x100000>;
			status = "disabled";
		};

		interrupt-controller@b0001000 {
			compatible = "arm,cortex-a7-gic";
			reg = <0xb0001000 0x1000 0xb0002000 0x1000>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			interrupts = <0x01 0x09 0xf04>;
			phandle = <0x01>;
		};
	};

	chosen {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;
		bootargs = "loglevel=6 console=ttyS1,115200";
	};

	aliases {
		serial0 = "/soc/uart0@40000000";
		serial1 = "/soc/uart1@40002000";
		serial2 = "/soc/uart2@40004000";
		serial3 = "/soc/uart3@40006000";
		serial4 = "/soc/usart0@40014000";
		serial5 = "/soc/usart1@40016000";
		arobot-spi0 = "/soc/spi0@400b0000";
		arobot-spi1 = "/soc/spi1@400b2000";
		arobot-spi2 = "/soc/spi2@400b4000";
		arobot-dma0 = "/soc/dma0@4005a000";
		arobot-dma1 = "/soc/dma1@40068000";
		arobot-mmc0 = "/soc/mmc0@400a0000";
		arobot-mmc1 = "/soc/mmc1@400a6000";
		arobot-cpu = "/cpus";
	};
};
