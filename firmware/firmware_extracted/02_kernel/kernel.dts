			};

			uart3_6 {
				pins = "PF5\0PF6";
				function = "uart3";
				arobot,drive = <0x00>;
			};

			uart3_s_6 {
				pins = "PF5\0PF6";
				function = "gpio";
				arobot,drive = <0x00>;
			};

			uart3_8@0 {
				pins = "PH8\0PH9";
				function = "uart3";
				arobot,drive = <0x00>;
			};

			uart3_s_8@0 {
