				function = "usart1";
				arobot,drive = <0x00>;
			};

			usart1_s_3_2 {
				pins = "PF0\0PF1";
				function = "gpio";
				arobot,drive = <0x00>;
			};

			spi0_1 {
				pins = "PE1\0PE2\0PE3\0PE4";
