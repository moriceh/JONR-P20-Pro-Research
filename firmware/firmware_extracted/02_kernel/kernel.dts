/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;
	model = "arobot-r8";
	compatible = "arobot,r8";

	memory@10000000 {
		reg = <0x10000000 0x8000000>;
		device_type = "memory";
	};

	cpus {
		enable-method = "arobot,r8-smp";
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			reg = <0x00>;
			clocks = <0x02 0x08>;
			clock-names = "cpu";
			operating-points-v2 = <0x03>;
			#cooling-cells = <0x02>;
			phandle = <0x04>;
		};

		cpu@1 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			reg = <0x01>;
			clocks = <0x02 0x08>;
			clock-names = "cpu";
			operating-points-v2 = <0x03>;
			#cooling-cells = <0x02>;
			phandle = <0x05>;
		};

		cpu@2 {
			compatible = "arm,cortex-a7";
			device_type = "cpu";
			reg = <0x02>;
			clocks = <0x02 0x08>;
			clock-names = "cpu";
			operating-points-v2 = <0x03>;
			#cooling-cells = <0x02>;
			phandle = <0x06>;
		};
	};

	cpu-opp-table {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x03>;

		opp-12000000 {
			opp-hz = <0x00 0xb71b00>;
			opp-microvolt = <0x124f80>;
		};

		opp-756000000 {
			opp-hz = <0x00 0x2d0fa500>;
			opp-microvolt = <0x150ea0>;
		};

		opp-612000000 {
			opp-hz = <0x00 0x247a6100>;
			opp-microvolt = <0x12ebc0>;
		};

		opp-712000000 {
			opp-hz = <0x00 0x2a704200>;
			opp-microvolt = <0x147260>;
		};
	};

	pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <0x00 0x78 0x04 0x00 0x79 0x04 0x00 0x7a 0x04>;
		interrupt-affinity = <0x04 0x05 0x06>;
	};

	timer {
		compatible = "arm,armv7-timer";
		arm,cpu-registers-not-fw-configured;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
	};

	clocks {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		osc12M_clk {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0xb71b00>;
			clock-output-names = "osc12M";
			clocks = <0x07>;
			clock-names = "osc12M";
			phandle = <0x07>;
		};

		osc32k_clk {
			#clock-cells = <0x00>;
			compatible = "fixed-clock";
			clock-frequency = <0x8000>;
			clock-output-names = "osc32k";
			phandle = <0x09>;
		};
	};

	arobot_cpufreq {
		compatible = "arobot,r8-cpufreq";
		clocks = <0x07 0x02 0x08 0x02 0x01>;
		clock-names = "hosc\0cpu\0cpu_pll";
		has-pmic = <0x00>;
		status = "okay";
	};

	dmadev {
		compatible = "arobot,dmadev";
		status = "disabled";
	};

	i2c0_gpio0 {
		compatible = "i2c-gpio";
		i2c-gpio,delay-us = <0x02>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		gpios = <0x08 0x01 0x0b 0x00 0x08 0x01 0x0a 0x00>;
	};

	i2c1_gpio0 {
		compatible = "i2c-gpio";
		i2c-gpio,delay-us = <0x02>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "disabled";
	};

	wlan-data {
		type = "wlan";
		compatible = "arobot,rfkill";
		status = "disabled";
	};

	gpio-keys_0 {
		compatible = "gpio-keys";
		status = "disabled";
	};

	efuse@40048000 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "arobot,r8-efuse";
		reg = <0x40048000 0x80 0x4003c300 0x04>;
		clocks = <0x02 0x35>;
		clock-names = "pclk_efuse";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		cpuentry@0 {
			compatible = "arobot,cpuentry";
			reg = <0x00 0x40>;
		};

		cpucfg@4005e000 {
			compatible = "arobot,cpuconfig";
			reg = <0x4005e000 0x80>;
		};

		clock@40080000 {
			compatible = "arobot,r8-ckcu";
			reg = <0x40080000 0x2000>;
			clocks = <0x07 0x09>;
			clock-names = "hosc\0losc";
			#clock-cells = <0x01>;
			phandle = <0x02>;
		};

		rstcu@40080100 {
			compatible = "arobot,r8-reset";
			#reset-cells = <0x01>;
			reg = <0x40080100 0x20>;
			status = "okay";
			phandle = <0x0a>;
		};

		pinctrl@40034000 {
			compatible = "arobot,r8-pinctrl";
			reg = <0x40034000 0x4000 0x40070000 0x7000 0x40036000 0x1000>;
			interrupts = <0x00 0x53 0x04 0x00 0x54 0x04 0x00 0x55 0x04 0x00 0x56 0x04 0x00 0x57 0x04 0x00 0x58 0x04 0x00 0x59 0x04 0x00 0x5a 0x04 0x00 0x5b 0x04 0x00 0x5c 0x04 0x00 0x5d 0x04 0x00 0x5e 0x04 0x00 0x5f 0x04 0x00 0x60 0x04 0x00 0x61 0x04 0x00 0x62 0x04>;
			clocks = <0x02 0x6a 0x02 0x69 0x02 0x68 0x02 0x67 0x02 0x66 0x02 0x65 0x02 0x64 0x02 0x63 0x02 0x62 0x02 0x61>;
			clock-names = "afio\0exti\0gpioa\0gpiob\0gpioc\0gpiod\0gpioe\0gpiof\0gpiog\0gpioh";
			gpio-controller;
			#gpio-cells = <0x03>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			exti-nirqs = <0x01>;
			phandle = <0x08>;

			gpa {
				gpio-controller;
				#gpio-cells = <0x02>;
			};

			gpb {
				gpio-controller;
				#gpio-cells = <0x02>;
			};

			gpc {
				gpio-controller;
				#gpio-cells = <0x02>;
			};

			gpd {
				gpio-controller;
				#gpio-cells = <0x02>;
			};

			gpe {
				gpio-controller;
				#gpio-cells = <0x02>;
			};

			gpg {
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
			};

			uart0_0 {
				pins = "PA13\0PA14";
				function = "uart0";
				arobot,drive = <0x00>;
			};

			uart0_s_0 {
				pins = "PA13\0PA14";
				function = "gpio";
				arobot,drive = <0x00>;
			};

			uart0_6 {
				pins = "PG8\0PG9";
				function = "uart0";
				arobot,drive = <0x00>;
			};

			uart0_s_6 {
				pins = "PG8\0PG9";
				function = "gpio";
				arobot,drive = <0x00>;
			};

			uart1_0 {
				pins = "PA2\0PA3";
				function = "uart1";
				arobot,drive = <0x00>;
			};

			uart1_s_0 {
				pins = "PG10\0PG11";
				function = "gpio";
				arobot,drive = <0x00>;
			};

			uart1_1 {
				pins = "PG10\0PG11";
				function = "uart1";
				arobot,drive = <0x00>;
			};

			uart1_rx_1 {
				pins = "PG10";
				function = "uart1";
				arobot,drive = <0x00>;
			};

			uart1_rx_s_1 {
				pins = "PG10";
				function = "gpio";
				arobot,drive = <0x00>;
			};

			uart1_rx_2 {
				pins = "PF3";
				function = "uart1";
				arobot,drive = <0x00>;
			};

			uart1_rx_s_2 {
				pins = "PF3";
				function = "gpio";
				arobot,drive = <0x00>;
			};

			uart2_0 {
				pins = "PA4\0PA5";
				function = "uart2";
				arobot,drive = <0x00>;
			};

			uart2_s_0 {
				pins = "PA4\0PA5";
